# ============================================
# SSN ELITE — Environment Template
# ============================================
# NOTE: SSN ELITE is a 100% static informational web app.
# It requires ZERO API keys, ZERO database credentials, and ZERO backend secrets.
# Do NOT place any secret API keys or private tokens in this file or any bundled frontend files.
# ============================================

PUBLIC_SITE_URL=https://ssnelite.com
PUBLIC_ENVIRONMENT=production

# Vercel server-side variables for the protected blog publisher.
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_ALLOWED_USER=your_github_username
GITHUB_REPO=BhanusMeet/SSN-WEB-SITE2
GITHUB_BRANCH=main
GITHUB_OAUTH_REDIRECT_URI=https://your-domain.com/api/auth/callback
